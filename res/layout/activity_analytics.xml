<?xml version="1.0" encoding="utf-8"?>
<!-- MWA-20: Analytics & Crash Reporting Screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Usage Statistics" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Sessions Today:" android:textColor="#757575"/>
            <TextView android:id="@+id/tv_sessions_today"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Avg Session Duration:" android:textColor="#757575"/>
            <TextView android:id="@+id/tv_avg_duration"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="3m 24s" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Transactions Today:" android:textColor="#757575"/>
            <TextView android:id="@+id/tv_txns_today"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="8" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Chart placeholder -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Transaction Volume (This Week)" android:textStyle="bold" android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp" app:cardElevation="2dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="16dp">
                <!-- Placeholder for chart (e.g. MPAndroidChart BarChart) -->
                <View android:id="@+id/chart_transaction_volume"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E3F2FD"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:gravity="center"
                    android:text="M   T   W   T   F   S   S"
                    android:textSize="12sp" android:textColor="#757575"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Crash reports section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Crash Reports" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="8dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#E8F5E9">
            <TextView android:id="@+id/tv_crash_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="✅ No crashes in last 7 days"
                android:textColor="#2E7D32" android:textStyle="bold"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="App Version:" android:textColor="#757575"/>
            <TextView android:id="@+id/tv_app_version"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1.0.0 (Build 42)" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Firebase Project:" android:textColor="#757575"/>
            <TextView android:id="@+id/tv_firebase_project"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="mwa-prod" android:textStyle="bold"/>
        </LinearLayout>

        <Button android:id="@+id/btn_view_full_report"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="VIEW FULL REPORT" android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
