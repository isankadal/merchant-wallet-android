<?xml version="1.0" encoding="utf-8"?>
<!-- MWA-03: KYC Status Screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_kyc_status_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:contentDescription="KYC status icon"
            android:src="@android:drawable/ic_dialog_info"/>

        <TextView
            android:id="@+id/tv_kyc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PENDING"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F9A825"/>

        <TextView
            android:id="@+id/tv_kyc_status_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Verification in Progress"
            android:textSize="14sp"
            android:textColor="#757575"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tv_submitted_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submitted: 10 Sep 2026"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tv_last_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Last Updated: 10 Sep 2026"
                    android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Checklist:"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView android:id="@+id/tv_check_personal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="✅  Personal Details" android:textSize="14sp"/>
        <TextView android:id="@+id/tv_check_business"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="✅  Business Details" android:textSize="14sp"/>
        <TextView android:id="@+id/tv_check_documents"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="⏳  Document Verification" android:textSize="14sp"/>

        <Button
            android:id="@+id/btn_refresh_status"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="REFRESH STATUS"
            android:textSize="16sp"/>

        <!-- Rejection section, hidden by default -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_rejection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF3E0">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ Rejection Reason"
                    android:textStyle="bold"
                    android:textColor="#E65100"/>
                <TextView
                    android:id="@+id/tv_rejection_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Document unclear"
                    android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_resubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="RE-SUBMIT KYC"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
