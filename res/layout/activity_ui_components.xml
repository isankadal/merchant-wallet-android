<?xml version="1.0" encoding="utf-8"?>
<!-- MWA-18: UI Component Library / Design System Preview Screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Buttons section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Buttons" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btn_primary_sample"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="PRIMARY BUTTON"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btn_secondary_sample"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="SECONDARY BUTTON"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_marginBottom="24dp"/>

        <!-- Typography section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Typography" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="H1 — Screen Title"
            android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="H2 — Section Heading"
            android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Body — Regular text content"
            android:textSize="14sp" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Caption — Small helper text"
            android:textSize="12sp" android:textColor="#757575"
            android:layout_marginBottom="24dp"/>

        <!-- Input field section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Input Field" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Placeholder text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="4dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sample_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ Error helper text"
            android:textSize="12sp" android:textColor="#D32F2F"
            android:layout_marginBottom="24dp"/>

        <!-- Toast sample -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#E8F5E9">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="✅ Success message"
                android:textColor="#2E7D32"
                android:textStyle="bold"/>
        </androidx.cardview.widget.CardView>

        <!-- Color swatches -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Brand Colors" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <View android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="?attr/colorPrimary" android:layout_margin="4dp"/>
            <View android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="?attr/colorSecondary" android:layout_margin="4dp"/>
            <View android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="#D32F2F" android:layout_margin="4dp"/>
            <View android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="#2E7D32" android:layout_margin="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
