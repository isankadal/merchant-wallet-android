<?xml version="1.0" encoding="utf-8"?>
<!-- MWA-14: Authentication / Login / MPIN Screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="🔐"
            android:textSize="56sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Merchant Wallet Login"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mobile Number"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="10"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="──── OR Enter MPIN ────"
            android:textColor="#BDBDBD"
            android:layout_marginBottom="16dp"/>

        <!-- MPIN dots indicator -->
        <LinearLayout
            android:id="@+id/ll_mpin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
            <View android:layout_width="16dp" android:layout_height="16dp"
                android:background="#BDBDBD" android:layout_margin="6dp"/>
        </LinearLayout>

        <!-- Number pad -->
        <GridLayout
            android:id="@+id/grid_numpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginBottom="24dp">

            <Button android:id="@+id/btn_1" android:layout_width="80dp" android:layout_height="64dp"
                android:text="1" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_2" android:layout_width="80dp" android:layout_height="64dp"
                android:text="2" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_3" android:layout_width="80dp" android:layout_height="64dp"
                android:text="3" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_4" android:layout_width="80dp" android:layout_height="64dp"
                android:text="4" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_5" android:layout_width="80dp" android:layout_height="64dp"
                android:text="5" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_6" android:layout_width="80dp" android:layout_height="64dp"
                android:text="6" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_7" android:layout_width="80dp" android:layout_height="64dp"
                android:text="7" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_8" android:layout_width="80dp" android:layout_height="64dp"
                android:text="8" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_9" android:layout_width="80dp" android:layout_height="64dp"
                android:text="9" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <View android:layout_width="80dp" android:layout_height="64dp"/>
            <Button android:id="@+id/btn_0" android:layout_width="80dp" android:layout_height="64dp"
                android:text="0" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button android:id="@+id/btn_backspace" android:layout_width="80dp" android:layout_height="64dp"
                android:text="⌫" android:textSize="20sp" style="@style/Widget.AppCompat.Button.Borderless"/>
        </GridLayout>

        <Button android:id="@+id/btn_biometric"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Use Biometric 👆"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_forgot_mpin"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Forgot MPIN?"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
