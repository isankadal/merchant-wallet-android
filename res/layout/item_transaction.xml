<?xml version="1.0" encoding="utf-8"?>
<!-- MWA-10: Transaction List Item -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_txn_direction_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↑"
            android:textSize="18sp"
            android:textColor="#D32F2F"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/tv_txn_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPI Payment"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tv_txn_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="merchant@upi  2:30 PM"
                android:textSize="12sp"
                android:textColor="#757575"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_txn_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-₹500"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#D32F2F"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
